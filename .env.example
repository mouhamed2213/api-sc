# Copie ce fichier en .env puis adapte les valeurs.
NODE_ENV=development
PORT=4000

# PostgreSQL (voir docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/support_connecte?schema=public"

# Génère une vraie clé : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-change-me-change-me-change-me"
JWT_EXPIRES_IN=7d

# Origines autorisées (séparées par des virgules) : l'URL de ton front
CORS_ORIGIN="http://localhost:5173,http://localhost:4200"

# Base des liens envoyés par e-mail (vérification, reset)
APP_URL="http://localhost:5173"
# Obligatoire pour la validation de configuration (remplacer par un vrai token si l’envoi d’e-mails est activé)
MAILTRAP_API_TOKEN=replace-with-mailtrap-token

# true = un client doit confirmer son e-mail avant de modifier une fiche
REQUIRE_EMAIL_VERIFICATION=false

# Nombre max de fiches qu'un client peut créer lui-même (à décider)
MAX_FICHES_PER_USER=3

# Stockage des médias (API S3-compatible, par exemple SeaweedFS)
# Endpoint S3 local typique de SeaweedFS : http://localhost:8333
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_REGION=us-east-1
S3_BUCKET=ficheImage

# URL publique de l'API utilisée pour générer les références de médias
SERVER=http://localhost:4000/api

# FFmpeg doit être installé sur le serveur pour optimiser images et vidéos
FFMPEG_PATH=ffmpeg
